# Python virtualenv (machine-specific)
venv/

# Ephemeral logs and bench runs
logs/*.log
logs/*.err
logs/*.json
logs/downloads/

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
__pycache__/
*.pyc

# Local overrides
.env
.env-*
*.local

# Timestamped config backups (created when editing llama-swap.yaml etc.)
*.bak.*
*.bak

# Agent operational memory — not for public repo (commercial notes, topology, gateway domain)
memory/

# The gateway hostname is deliberately absent from this repo — docs use the
# <gateway-host> placeholder and it is supplied to clients with their key.
# History was rewritten on 2026-08-13 to remove three occurrences that had
# leaked in; keep it out of new commits.

# Local quantized model weights (18 GB+) — never commit
models/
