# ────────────────────────────────────────────────────────────────────────
# bar / formatting helpers
# ────────────────────────────────────────────────────────────────────────

# octants: 8 sub-cell levels for smooth bars
_OCTANTS = ["", "▏", "▎", "▍", "▌", "▋", "▊", "▉"]


def smooth_bar(pct: float, width: int = 12, fill_color: str = "tn.info",
               track_color: str = "tn.fg.muted") -> str:
    """Return rich-markup smooth bar with octant precision and dim track."""
    pct = max(0.0, min(100.0, pct))
    eighths = int(round(pct / 100.0 * width * 8))
    full = eighths // 8
    rem = eighths % 8
    full = min(full, width)
    fill_chars = "█" * full
    if rem > 0 and full < width:
        fill_chars += _OCTANTS[rem]
        full += 1
    track = "─" * (width - full)
    return f"[{fill_color}]{fill_chars}[/][{track_color}]{track}[/]"


def fmt_size(n: Optional[int]) -> str:
    if n is None:
        return "-"
    if n >= 1000:
        return f"{n // 1000}k"
    return str(n)


def fmt_id(rid: str) -> str:
    if rid.startswith("chatcmpl-"):
        rid = rid[len("chatcmpl-"):]
    return rid[:6]


def fmt_dur(s: float) -> str:
    if s < 1:
        return f"{s*1000:.0f}ms"
    if s < 60:
        return f"{s:.1f}s"
    return f"{s/60:.1f}m"


def fmt_seconds(s: float) -> str:
    s = max(0, int(s))
    if s < 60:
        return f"{s}s"
    return f"{s // 60}m{s % 60:02d}s"


def thresh_color(pct: float, green_below: float, yellow_below: float) -> str:
    """For metrics where higher = worse (temp, KV, MEM)."""
    if pct < green_below:
        return "tn.success"
    if pct < yellow_below:
        return "tn.warning"
    return "tn.danger"


def thresh_color_inv(pct: float, red_below: float, yellow_below: float) -> str:
    """For metrics where higher = better (acceptance)."""
    if pct < red_below:
        return "tn.danger"
    if pct < yellow_below:
        return "tn.warning"
    return "tn.success"


def pill(label: str, style: str) -> str:
    """Reverse-video pill badge: ` LABEL ` with bg color."""
    return f"[{style}] {label} [/]"


# ────────────────────────────────────────────────────────────────────────
# Cockpit instrument row
# ────────────────────────────────────────────────────────────────────────

def make_instruments_row(snap: dict, gpu: dict, mem: dict,
                         tps: float, total_width: int = 100) -> Panel:
    # 3 gauges per row, 2 rows. Each gauge: fixed-width prefix (label +
    # value), then bar, then optional trailing percentage. The fixed prefix
    # makes bars start at the same x-position in every gauge.
    PREFIX_W = 11   # cells for "LBL  VAL" (e.g. "GPU   65C")
    TRAIL_W  = 5    # cells for trailing percentage (e.g. " 65%")

    inner_w = max(48, total_width - 8)  # panel borders + outer padding
    slot_w = inner_w // 3
    # Each slot also pays 2 cells of inter-column table padding.
    bar_w = max(6, slot_w - PREFIX_W - TRAIL_W - 4)

    def fmt_gauge(label: str, value: str, bar_pct: float, fill_color: str,
                  trail: str = "") -> str:
        plain_prefix = f"{label:<3}  {value}"
        prefix_pad = max(0, PREFIX_W - len(plain_prefix))
        prefix_str = (f"[tn.fg.dim]{label:<3}[/]  "
                      f"[{fill_color}]{value}[/]" + " " * prefix_pad)
        bar_str = smooth_bar(bar_pct, bar_w, fill_color=fill_color)
        plain_trail = trail
        trail_pad = max(0, TRAIL_W - len(plain_trail))
        trail_str = " " * trail_pad + (f"[tn.fg.dim]{trail}[/]" if trail else "")
        return f"{prefix_str} {bar_str} {trail_str}"

    # GPU
    temp = gpu.get("temp")
    util = gpu.get("util") or 0.0
    pwr = gpu.get("power") or 0.0
    if temp is None:
        gpu_part = "[tn.fg.muted]GPU --[/]"
    else:
        c = thresh_color(temp, 60, 80)
        gpu_part = fmt_gauge("GPU", f"{temp:>3.0f}C", util, c,
                             f"{util:>3.0f}%")

    # MEM
    if mem.get("total_gb") and mem.get("used_gb") is not None:
        used_pct = mem["used_gb"] / mem["total_gb"] * 100
        c = thresh_color(used_pct, 70, 90)
        mem_part = fmt_gauge("MEM", f"{mem['used_gb']:>3.0f}G", used_pct, c,
                             f"{used_pct:>3.0f}%")
    else:
        mem_part = "[tn.fg.muted]MEM --[/]"

    # KV
    kv_pct = snap.get("kv") or 0.0
    c = thresh_color(kv_pct, 70, 90)
    kv_part = fmt_gauge("KV", f"{kv_pct:>4.1f}%", kv_pct, c)

    # ACC (spec acceptance, higher is better)
    acc_pct = 0.0
    if snap.get("spec_drafted"):
        acc_pct = snap["spec_accepted"] / snap["spec_drafted"] * 100
    c = thresh_color_inv(acc_pct, 50, 70)
    acc_part = fmt_gauge("ACC", f"{acc_pct:>3.0f}%", acc_pct, c)

    # TPS (decode tok/s, normalized to 30 t/s for bar)
    tps_norm = min(100.0, (tps / 30.0) * 100)
    tps_color = ("tn.success" if tps > 10
                 else "tn.warning" if tps > 5 else "tn.fg.muted")
    tps_part = fmt_gauge("TPS", f"{tps:>4.1f}", tps_norm, tps_color)

    # PWR (power draw, % of 240W TDP)
    pwr_pct = min(100.0, (pwr / 240.0) * 100)
    pwr_color = thresh_color(pwr_pct, 60, 85)
    pwr_part = fmt_gauge("PWR", f"{pwr:>3.0f}W", pwr_pct, pwr_color,
                         f"{pwr_pct:>3.0f}%")

    # Real Table with HORIZONTALS box draws a divider line between the two
    # gauge rows so they don't bleed into one continuous bar of same color.
    t = Table(box=box.HORIZONTALS, show_header=False, show_edge=False,
              show_lines=True, expand=True, padding=(0, 1),
              border_style="tn.fg.muted")
    t.add_column(ratio=1, no_wrap=True)
    t.add_column(ratio=1, no_wrap=True)
    t.add_column(ratio=1, no_wrap=True)
    t.add_row(gpu_part, mem_part, kv_part)
    t.add_row(acc_part, tps_part, pwr_part)
    return Panel(t, title="cockpit", title_align="left",
                 border_style="tn.border", box=box.ROUNDED, padding=(0, 0))


# ────────────────────────────────────────────────────────────────────────
# Gantt rendering
# ────────────────────────────────────────────────────────────────────────

# Distinct phase glyphs: thin heavy-horizontal for prefill (low body) +
# full block for decode (full body). Visual weight encodes the phase.
PHASE_PREFILL = "━"      # heavy horizontal rule, U+2501 (box drawing, ASCII-rendered)
PHASE_DECODE = "█"       # full block
TIP_INFLIGHT = ">"       # ascii arrow
GAP_CHAR = " "

FINISH_LABEL = {
    "stop": "completed", "length": "length", "abort": "aborted",
    "error": "errored", "repetition": "repeat",
}
FINISH_COLOR = {
    "stop": "tn.success", "length": "tn.warning",
    "abort": "tn.danger", "error": "tn.danger",
    "repetition": "tn.orange",
}
FINISH_PILL = {
    "stop": "tn.pill.success", "length": "tn.pill.warning",
    "abort": "tn.pill.danger", "error": "tn.pill.danger",
    "repetition": "tn.pill.muted",
}
# Inner timeline width (between brackets). Total visible column = BAR_WIDTH + 2.
BAR_WIDTH = 28
# Inner width of the in/out token bars. Total column width = IO_BAR_WIDTH + 2.
IO_BAR_WIDTH = 6
# Absolute scales for the in/out bars. Anchoring to fixed budgets gives an
# honest "how full is the context" / "how big is the reply" reading,
# instead of session-max relative scaling that distorts magnitudes.
IN_SCALE_MAX = 200_000   # matches --max-model-len
OUT_SCALE_MAX = 8_192    # typical max output for thinking-mode coding traffic


def render_bar_text(req: RequestState, view_start: float,
                    view_end: float, width: int = BAR_WIDTH) -> Text:
    """Bracket-framed timeline: [   ━━━██████>      ]
    The inside is `width` cells; brackets add 2 visible cells around it.
    Gaps inside the brackets are spaces so phase chars stand alone.
    """
    span = view_end - view_start
    if span <= 0:
        # all-empty bracket frame
        t = Text()
        t.append("[", style="tn.fg.muted")
        t.append(" " * width)
        t.append("]", style="tn.fg.muted")
        return t

    def to_col(ts: float) -> int:
        return max(0, min(width - 1,
                          int(((ts - view_start) / span) * width)))

    start_col = to_col(req.start_ts)
    end_ts = req.end_ts if req.end_ts is not None else view_end
    end_col = to_col(end_ts)
    if end_col < start_col:
        end_col = start_col

    in_flight = req.end_ts is None
    finish_color = FINISH_COLOR.get(req.finish_reason or "", "tn.fg.dim")
    body_color = "tn.info" if in_flight else finish_color
    prefill_color = "tn.teal" if in_flight else finish_color

    # build the inside of the brackets
    inner = Text()
    inner.append(" " * start_col)  # leading gap

    if req.prefill_done_ts is not None:
        prefill_col = to_col(req.prefill_done_ts)
        prefill_end = min(prefill_col, end_col)
        prefill_len = max(0, prefill_end - start_col + 1)
        if in_flight:
            decode_len = max(0, end_col - prefill_end - 1)
            tip_used = 1
        else:
            decode_len = max(0, end_col - prefill_end)
            tip_used = 0
        inner.append(PHASE_PREFILL * prefill_len, style=prefill_color)
        inner.append(PHASE_DECODE * decode_len, style=body_color)
        if in_flight:
            inner.append(TIP_INFLIGHT, style="bold tn.info")
        consumed = start_col + prefill_len + decode_len + tip_used
        inner.append(" " * max(0, width - consumed))
    else:
        body_len = max(0, end_col - start_col + 1)
        if in_flight and body_len > 0:
            inner.append(PHASE_PREFILL * (body_len - 1), style=prefill_color)
            inner.append(TIP_INFLIGHT, style="bold tn.info")
        else:
            inner.append(PHASE_PREFILL * body_len, style=prefill_color)
        consumed = start_col + body_len
        inner.append(" " * max(0, width - consumed))

    # exact width
    if len(inner.plain) > width:
        inner.truncate(width)
    elif len(inner.plain) < width:
        inner.append(" " * (width - len(inner.plain)))

    out = Text()
    out.append("[", style="tn.fg.muted")
    out.append_text(inner)
    out.append("]", style="tn.fg.muted")
    return out


# octant chars for sub-cell precision on the in/out mini-bars
_OCTANTS = ["", "▏", "▎", "▍", "▌", "▋", "▊", "▉"]


def _scaled_bar(value: int, scale_max: int, width: int,
                style: str) -> Text:
    """Horizontal bar of `width` cells, length proportional to value/scale_max.
    Uses octant chars on the trailing edge for sub-cell precision.
    Any value > 0 renders at least a single octant tick so small reqs
    are still visible at narrow widths."""
    out = Text()
    if value <= 0 or scale_max <= 0:
        out.append(" " * width)
        return out
    cells_f = (value / scale_max) * width
    full = int(cells_f)
    frac = cells_f - full
    full = min(full, width)
    out.append("█" * full, style=style)
    if full < width:
        if frac > 0:
            idx = int(round(frac * 8))
            if idx >= 8:
                out.append("█", style=style)
                full += 1
            elif idx > 0:
                out.append(_OCTANTS[idx], style=style)
                full += 1
        # guarantee at least 1 octant tick for tiny non-zero values
        if full == 0 and value > 0:
            out.append(_OCTANTS[1], style=style)
            full = 1
    out.append(" " * max(0, width - full))
    return out


def io_bar(value: Optional[int], scale_max: int, style: str,
           inner_w: int = IO_BAR_WIDTH) -> Text:
    """A bracketed in/out bar (column = inner_w + 2)."""
    inner = _scaled_bar(value or 0, scale_max, inner_w, style)
    out = Text("[", style="tn.fg.muted")
    out.append_text(inner)
    out.append("]", style="tn.fg.muted")
    return out


def render_inflight_info(r: "RequestState", view_start: float, now: float,
                         total_w: int) -> Text:
    """Compose the dynamic info cell for an inflight request:
    'in <prompt> [─────live-timeline─────] <gen-live>' """
    in_str = fmt_size(r.prompt_tokens) if r.prompt_tokens else "-"
    live_gen = int(r.gen_accum) if r.gen_accum > 0 else 0
    out_str = fmt_size(live_gen) if live_gen > 0 else "-"

    in_lbl = f"in {in_str:>4} "      # 8 chars
    out_lbl = f" {out_str:>4}"        # 5 chars
    bar_w = max(10, total_w - len(in_lbl) - len(out_lbl) - 2)  # -2 for [ ]

    out = Text()
    out.append(in_lbl, style="tn.fg.muted")
    out.append_text(render_bar_text(r, view_start, now, width=bar_w))
    out.append(out_lbl, style="tn.fg.dim")
    return out


def render_completed_info(r: "RequestState", total_w: int) -> Text:
    """Compose the dynamic info cell for a completed request:
    'in <prompt> [in-bar]   out <gen> [out-bar]' """
    in_str = fmt_size(r.prompt_tokens) if r.prompt_tokens else "-"
    out_str = fmt_size(r.gen_tokens) if r.gen_tokens else "-"

    in_lbl = f"in {in_str:>4} "        # 8 chars
    out_lbl = f"   out {out_str:>4} "  # 12 chars
    fixed = len(in_lbl) + len(out_lbl) + 4  # 4 = two pairs of [ ]
    bar_total = max(8, total_w - fixed)
    bar1_w = bar_total // 2
    bar2_w = bar_total - bar1_w

    out = Text()
    out.append(in_lbl, style="tn.fg.muted")
    out.append_text(io_bar(r.prompt_tokens, IN_SCALE_MAX, "tn.info",
                           inner_w=bar1_w))
    out.append(out_lbl, style="tn.fg.muted")
    out.append_text(io_bar(r.gen_tokens, OUT_SCALE_MAX, "tn.success",
                           inner_w=bar2_w))
    return out


def make_gantt_table(requests: "OrderedDict[str, RequestState]",
                     view_duration: float,
                     terminal_width: int = 120) -> Table:
    now = time.time()
    view_start = now - view_duration

    inflight = [r for r in requests.values() if r.end_ts is None]
    completed = [r for r in requests.values()
                 if r.end_ts is not None and r.end_ts >= view_start]

    # Fixed-width columns: id(6) + key(13) + start(8) + ttft(6) + tps(5)
    # + dur(7) + status(12) + 7 column-paddings(2*8=16) + 2 panel borders.
    # The key column is populated from log-proxy meta files (Phase 3).
    KEY_W = 13
    fixed_cols_w = 6 + KEY_W + 8 + 6 + 5 + 7 + 12 + 16
    info_w = max(40, terminal_width - fixed_cols_w)

    table = Table.grid(expand=False, padding=(0, 1))
    table.add_column("id", no_wrap=True, width=6)
    table.add_column("key", no_wrap=True, width=KEY_W)
    table.add_column("start", width=8)
    table.add_column("info", width=info_w, no_wrap=True)
    table.add_column("ttft", justify="right", width=6)
    table.add_column("tps", justify="right", width=5)
    table.add_column("dur", justify="right", width=7)
    table.add_column("status", width=12)

    # column header row
    table.add_row(
        Text("id", style="tn.fg.muted"),
        Text("key", style="tn.fg.muted"),
        Text("start", style="tn.fg.muted"),
        Text(" in / timeline / out".ljust(info_w), style="tn.fg.muted"),
        Text("ttft", style="tn.fg.muted"),
        Text("tps", style="tn.fg.muted"),
        Text("dur", style="tn.fg.muted"),
        Text("status", style="tn.fg.muted"),
    )
    table.add_row(
        Text("─" * 6, style="tn.border"),
        Text("─" * KEY_W, style="tn.border"),
        Text("─" * 8, style="tn.border"),
        Text("─" * info_w, style="tn.border"),
        Text("─" * 6, style="tn.border"),
        Text("─" * 5, style="tn.border"),
        Text("─" * 7, style="tn.border"),
        Text("─" * 12, style="tn.border"),
    )

    def _key_cell(r: "RequestState", style: str) -> Text:
        label = r.key_masked or "—"
        return Text(label, style=style)

    if inflight:
        for r in sorted(inflight, key=lambda x: x.start_ts):
            elapsed = now - r.start_ts
            if r.prefill_done_ts is not None:
                ttft_str = fmt_dur(r.prefill_done_ts - r.start_ts)
            else:
                ttft_str = "-"
            table.add_row(
                Text(fmt_id(r.request_id), style="bold tn.info"),
                _key_cell(r, "tn.accent"),
                Text(datetime.fromtimestamp(r.start_ts).strftime("%H:%M:%S"),
                     style="tn.fg.dim"),
                render_inflight_info(r, view_start, now, info_w),
                Text(ttft_str, style="tn.fg.dim"),
                Text("-", style="tn.fg.muted"),
                Text(fmt_dur(elapsed), style="tn.fg"),
                Text.from_markup(pill("running", "tn.pill.info")),
            )
        # subtle divider before completed section
        table.add_row(
            Text(""), Text(""), Text(""),
            Text("·" * info_w, style="tn.fg.muted"),
            Text(""), Text(""), Text(""), Text(""),
        )

    if not completed and not inflight:
        table.add_row(
            Text("(idle - no requests in view window)",
                 style="tn.fg.muted italic"),
            "", "", "", "", "", "", "",
        )
        return table

    completed_sorted = sorted(completed, key=lambda x: x.start_ts,
                              reverse=True)[:30]
    for r in completed_sorted:
        dur = (r.end_ts - r.start_ts) if r.end_ts else 0.0
        label = FINISH_LABEL.get(r.finish_reason or "", "?")
        pill_style = FINISH_PILL.get(r.finish_reason or "", "tn.pill.muted")

        # decode tps = gen_tokens / decode_duration
        tps_str = "-"
        if r.gen_tokens and r.gen_tokens > 0:
            if r.prefill_done_ts and r.end_ts:
                decode_dur = max(0.001, r.end_ts - r.prefill_done_ts)
            else:
                decode_dur = max(0.001, dur)
            tps_val = r.gen_tokens / decode_dur
            tps_str = f"{tps_val:.1f}"

        trunc = (r.gen_tokens is not None and r.gen_tokens < 5
                 and (r.prompt_tokens or 0) > 100
                 and r.finish_reason == "stop")
        heavy = (r.gen_tokens or 0) > 2000
        if trunc:
            finish_text = Text.from_markup(pill("truncated", "tn.pill.danger"))
        elif heavy:
            finish_text = Text.from_markup(
                pill(f"{label} (heavy)", "tn.pill.warning"))
        else:
            finish_text = Text.from_markup(pill(label, pill_style))

        if r.prefill_done_ts is not None:
            ttft_str = fmt_dur(r.prefill_done_ts - r.start_ts)
        else:
            ttft_str = "-"

        table.add_row(
            Text(fmt_id(r.request_id), style="tn.fg.dim"),
            _key_cell(r, "tn.fg.dim"),
            Text(datetime.fromtimestamp(r.start_ts).strftime("%H:%M:%S"),
                 style="tn.fg.muted"),
            render_completed_info(r, info_w),
            Text(ttft_str, style="tn.fg.dim"),
            Text(tps_str, style="tn.fg.dim"),
            Text(fmt_dur(dur), style="tn.fg.dim"),
            finish_text,
        )

    return table


# ────────────────────────────────────────────────────────────────────────
# Header (with explicit cold-start stage progress)
# ────────────────────────────────────────────────────────────────────────

def make_state_pill(metrics_ok: bool, snap: dict, sp: dict) -> str:
    """Return a markup string with the engine state as a pill badge."""
    if sp["stage"] == "CRASHED":
        return pill("CRASHED", "tn.pill.danger")
    if not metrics_ok:
        return pill("WARMING UP", "tn.pill.warning")
    running = int(snap["running"])
    waiting = int(snap["waiting"])
    if running > 0:
        return pill(f"SERVING {running}", "tn.pill.success")
    if waiting > 0:
        return pill(f"QUEUE {waiting}", "tn.pill.warning")
    return pill("READY", "tn.pill.success")


def make_progress_line(metrics_ok: bool, sp: dict) -> str:
    """Cold-start stage progress line. Empty markup if engine is up."""
    if metrics_ok and sp["stage"] in ("ready", "container starting"):
        return ""
    if sp["stage"] == "CRASHED":
        return "[tn.danger]engine init failed - check `docker logs`[/]"

    idx = sp["idx"]
    n = sp["n_progress_stages"]
    stage_name = sp["stage"]
    detail = sp["detail"]
    elapsed = sp["elapsed"]
    typical = sp["typical"]
    remaining = sp["remaining"]

    label_parts = []
    if idx >= 0:
        label_parts.append(f"[tn.fg.dim]stage[/] [tn.accent]{idx + 1}/{n}[/]")
    label_parts.append(f"[tn.fg]{stage_name}[/]")
    if detail:
        label_parts.append(f"[tn.fg.dim]{detail}[/]")
    label = "  ".join(label_parts)

    pct = min(100.0, (elapsed / typical) * 100.0) if typical > 0 else 0.0
    progress = smooth_bar(pct, width=18, fill_color="tn.warning",
                          track_color="tn.fg.muted")

    eta = (f"~{fmt_seconds(remaining)} left" if remaining > 0
           else f"{fmt_seconds(elapsed)} elapsed")
    return f"{label}    {progress}    [tn.fg.dim]{eta}[/]"


def make_engine_stats_line(snap: dict) -> str:
    """Aggregate stats since engine boot (mean TTFT, mean per-request decode
    rate, mean prompt/gen tokens, spec acceptance). Empty if no completed
    requests yet."""
    succ_total = (snap["succ_stop"] + snap["succ_length"] +
                  snap["succ_abort"] + snap["succ_error"])
    parts = []

    # mean TTFT (vLLM histogram sum/count, since boot)
    if snap["ttft_count"] > 0:
        mean_ttft = snap["ttft_sum"] / snap["ttft_count"]
        parts.append(f"[tn.fg.dim]TTFT[/] [tn.fg]{fmt_dur(mean_ttft)}[/]")

    # mean per-request decode rate (= 1 / mean TPOT)
    if snap["tpot_count"] > 0 and snap["tpot_sum"] > 0:
        mean_tpot = snap["tpot_sum"] / snap["tpot_count"]
        if mean_tpot > 0:
            mean_rate = 1.0 / mean_tpot
            parts.append(f"[tn.fg.dim]tok/s[/] [tn.fg]{mean_rate:.1f}[/]")

    # mean in/out tokens per request
    if succ_total > 0:
        mean_in = snap["prompt_total"] / succ_total
        mean_out = snap["gen_total"] / succ_total
        parts.append(f"[tn.fg.dim]in/out[/] [tn.fg]"
                     f"{fmt_size(int(mean_in))}/{fmt_size(int(mean_out))}[/]")

    # spec acceptance (since boot)
    if snap["spec_drafted"] > 0:
        acc = snap["spec_accepted"] / snap["spec_drafted"] * 100
        c = thresh_color_inv(acc, 50, 70)
        parts.append(f"[tn.fg.dim]acc[/] [{c}]{acc:.0f}%[/]")

    # mean e2e latency (since boot)
    if snap["e2e_count"] > 0:
        mean_e2e = snap["e2e_sum"] / snap["e2e_count"]
        parts.append(f"[tn.fg.dim]e2e[/] [tn.fg]{fmt_dur(mean_e2e)}[/]")

    return "    ".join(parts)


def make_header(engine: dict, snap: dict, uptime_s: float, view_label: str,
                tailer_status: str, metrics_ok: bool, sp: dict) -> Panel:
    state = make_state_pill(metrics_ok, snap, sp)
    progress = make_progress_line(metrics_ok, sp)
    stats = make_engine_stats_line(snap) if metrics_ok else ""

    succ_total = (snap["succ_stop"] + snap["succ_length"] +
                  snap["succ_abort"] + snap["succ_error"])
    flags = []
    if snap["succ_abort"]:
        flags.append(f"[tn.danger]aborts={int(snap['succ_abort'])}[/]")
    if snap["succ_error"]:
        flags.append(f"[tn.danger]errs={int(snap['succ_error'])}[/]")
    if snap["succ_length"]:
        flags.append(f"[tn.warning]len={int(snap['succ_length'])}[/]")
    if snap["preempt"]:
        flags.append(f"[tn.danger]preempt={int(snap['preempt'])}[/]")
    flag_str = "  " + "  ".join(flags) if flags else ""

    line1 = (
        f"{state}  [bold tn.fg]{engine['name']}[/]  "
        f"[tn.fg.muted]:{engine['port']}[/]  "
        f"[tn.fg.dim]reqs={int(succ_total)}[/]  "
        f"[tn.fg.dim]up {fmt_dur(uptime_s)}[/]{flag_str}"
    )
    body = line1
    # Progress wins the middle slot during cold-start; stats fill it once ready.
    if progress:
        body += f"\n{progress}"
    elif stats:
        body += f"\n{stats}"
    body += f"\n[tn.fg.muted]{tailer_status}[/]"

    return Panel(body, title="vLLM engine", title_align="left",
                 border_style="tn.border", box=box.ROUNDED)


def make_footer(view_label: str, n_inflight: int, n_completed: int,
                trunc_count: int, lines_seen: int) -> Text:
    t = Text()
    t.append(" ", style="tn.fg.muted")
    t.append(f"view {view_label}  ", style="tn.fg.muted")
    t.append("│  ", style="tn.fg.muted")
    t.append(f"in-flight {n_inflight}  ", style="tn.info")
    t.append("│  ", style="tn.fg.muted")
    t.append(f"completed {n_completed}  ", style="tn.success")
    if trunc_count:
        t.append("│  ", style="tn.fg.muted")
        t.append(f"trunc {trunc_count}  ", style="bold tn.danger")
    t.append("│  ", style="tn.fg.muted")
    t.append(f"log {lines_seen} lines  ", style="tn.fg.muted")
    t.append("│  ", style="tn.fg.muted")
    t.append("Ctrl-C to quit", style="tn.fg.muted italic")
    return t


# ────────────────────────────────────────────────────────────────────────
# main
# ────────────────────────────────────────────────────────────────────────

VIEW_PRESETS = {"1m": 60, "5m": 300, "15m": 900, "30m": 1800}


def main() -> int:
    p = argparse.ArgumentParser(
        description="Live cockpit TUI for the llama-swap engine stack."
    )
    p.add_argument("--port", type=int, default=None)
    p.add_argument("--container", default=None)
    p.add_argument("--view", default="5m", choices=list(VIEW_PRESETS.keys()))
    p.add_argument("--refresh", type=float, default=1.0)
    args = p.parse_args()

    if args.port and args.container:
        engine = {"name": args.container, "port": args.port}
    else:
        engines = discover_engines()
        if not engines:
            print("ERROR: no running vllm-* container found", file=sys.stderr)
            return 2
        if args.port:
            engine = next((e for e in engines if e["port"] == args.port),
                          engines[0])
        else:
            engine = engines[0]
        if args.container:
            engine["name"] = args.container

    view_duration = VIEW_PRESETS[args.view]
    monitor = EngineMonitor(engine, view_duration_s=float(view_duration))
    console = Console(theme=TN_THEME)

    def render() -> Layout:
        layout = Layout()
        layout.split_column(
            Layout(name="header", size=5),
            Layout(name="instruments", size=5),
            Layout(name="body"),
            Layout(name="footer", size=1),
        )

        monitor.tick()
        snap = monitor.snap
        sp = monitor.stage()
        counts = monitor.counts()

        tailer = monitor.tailer
        if tailer.lines_matched > 0:
            ts_status = (f"log {tailer.lines_matched}/"
                         f"{tailer.lines_seen} matched")
        elif tailer.lines_seen == 0:
            ts_status = "log: starting..."
        else:
            ts_status = (f"log 0/{tailer.lines_seen} matched - "
                         "is --enable-log-requests on?")

        layout["header"].update(make_header(
            engine, snap, time.time() - monitor.start_ts, args.view, ts_status,
            monitor.metrics_ok, sp,
        ))
        layout["instruments"].update(
            make_instruments_row(snap, monitor.gpu, monitor.mem,
                                 monitor.smoothed_tps,
                                 total_width=console.size.width)
        )

        with monitor.lock:
            term_w = console.size.width
            gantt = make_gantt_table(monitor.requests, view_duration,
                                     terminal_width=term_w)

        layout["body"].update(Panel(gantt, title="request timeline",
                                    title_align="left",
                                    border_style="tn.border",
                                    box=box.ROUNDED))
        layout["footer"].update(make_footer(
            args.view, counts["inflight"], counts["completed_in_view"],
            counts["trunc"], tailer.lines_seen,
        ))
        return layout

    try:
        with Live(render(), console=console,
                  refresh_per_second=4, screen=True) as live:
            while True:
                time.sleep(args.refresh)
                live.update(render())
    except KeyboardInterrupt:
        pass
    finally:
        monitor.stop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
