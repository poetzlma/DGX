#!/home/max/llm-stack/venv/bin/python3
"""Live cockpit TUI for the llama-swap engine stack.

Tokyo Night Storm palette. Octant-precision bars. Pill-style state badges.
Heavy horizontal "prefill" phase + full-block "decode" phase + ascii arrow
"in-flight" tip in the Gantt. Cold-start stage progress with elapsed/ETA.

Data sources:
- vLLM /metrics (KV usage, accept rate, request counts, histograms)
- vLLM stdout (per-request lifecycle if --enable-log-requests is on,
  plus cold-start phase detection)
- nvidia-smi (GPU temp + util + power; memory.* is N/A on GB10)
- /proc/meminfo (system unified memory; GB10 shares CPU+GPU mem)

Usage:
    stack-tui                    # auto-discover, 5-min view
    stack-tui --view 1m          # 1-min view (finer grain)
    stack-tui --view 30m         # 30-min view (session review)
    stack-tui --port 9016        # specific engine
    stack-tui --refresh 0.5      # half-second refresh

Press Ctrl-C to quit (alt-screen restored).
"""
import argparse
import os
import sys
import time
from datetime import datetime
from typing import Optional

from rich.console import Console
from rich.layout import Layout
from rich.live import Live
from rich.panel import Panel
from rich.table import Table
from rich.text import Text
from rich.theme import Theme
from rich import box

# Make sibling `stack/` package importable when stack-tui is launched from
# anywhere (systemd, ./bin/stack-tui, full path).
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from stack.engine import discover_engines  # noqa: E402
from stack.monitor import EngineMonitor, RequestState  # noqa: E402


