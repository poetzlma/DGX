    "tn.pill.danger":   "#c0caf5 on #f7768e",
    "tn.pill.info":     "#0a0a14 on #7dcfff",
    "tn.pill.accent":   "#0a0a14 on #7aa2f7",
    "tn.pill.muted":    "#c0caf5 on #3b4261",
})


# ────────────────────────────────────────────────────────────────────────
# (engine discovery, /metrics parsing, system stats, RequestState +
