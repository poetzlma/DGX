    "tn.fg.muted": "#565f89",
    # semantic accents
    "tn.accent":   "#7aa2f7",  # blue   - primary highlight
    "tn.info":     "#7dcfff",  # cyan   - in-flight
    "tn.success":  "#9ece6a",  # green  - stop / healthy
    "tn.warning":  "#e0af68",  # yellow - length / warming up
